{
  "name": "hermes-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
